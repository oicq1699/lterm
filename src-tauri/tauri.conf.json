{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lterm",
  "version": "0.2.0",
  "identifier": "dev.lterm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "lterm",
        "width": 1100,
        "height": 700,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "lterm",
    "copyright": "MIT",
    "category": "DeveloperTool"
  }
}