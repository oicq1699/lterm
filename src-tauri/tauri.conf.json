{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lterm",
  "version": "0.5.11",
  "identifier": "dev.lterm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "lterm",
        "width": 1100,
        "height": 700,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "lterm",
    "copyright": "MIT",
    "category": "DeveloperTool"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0N0M5OTIyNTdGOEJBMEYKUldRUHV2aFhJcGw4ZE56QWZvVlNyK3p3emFObkdzL0VnOTNtRW5lY256RFppYStUSW5qaHZubEgK",
      "endpoints": [
        "https://github.com/oicq1699/lterm/releases/latest/download/latest.json"
      ]
    }
  }
}